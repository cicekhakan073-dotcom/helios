# ============================ SEP-10 (oturum) ================================
# Sunucu SEP-10 imzalama tarafının Stellar secret'ı (S…). Yalnız challenge
# imzalamak için; transfer/ödeme yapmaz. `stellar keys generate` veya
# `openssl rand -hex 32` üreteceği bir Stellar keypair kullan.
HELIOS_SEP10_SIGNING_SECRET=

# JWT imza secret'ı (HS256). 32+ byte. `openssl rand -hex 32`.
HELIOS_JWT_SECRET=


# ============================ AI Copilot (PROMPT 25) =========================
# Anthropic API key. console.anthropic.com → API Keys → Create.
# Model: claude-sonnet-4-6 (kodda pinli).
ANTHROPIC_API_KEY=


# ============================ Faucet rate-limit (PROMPT 24) ==================
# Vercel Marketplace → Upstash Redis (`vercel install upstash`). Yoksa
# in-memory fallback (yalnız tek-instance dev güvenli).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ============================ Keeper cron (PROMPT 29) ========================
# Vercel cron `/api/keeper/cron` → Authorization: Bearer ${CRON_SECRET}.
# `openssl rand -base64 32`.
CRON_SECRET=

# Keeper Stellar secret. **get_keeper() ile EŞLEŞMELİ**: 2026-06-03 itibariyle
# rol deployer hesabıdır → KEEPER_SECRET=deployer secret. Tx atan tek hesap.
KEEPER_SECRET=

# Opsiyonel: CSV adres listesi (KV yokken cron'un tarayacağı opt-in user'lar).
# G-adresleri virgülle ayır. Demo/dev dışı kullanma.
KEEPER_USER_LIST=


# ============================ Web Push (PROMPT 31) ===========================
# Anahtarları üret: `pnpm dlx web-push generate-vapid-keys`.
# - PUBLIC key client tarafında subscription için kullanılır (NEXT_PUBLIC_).
# - PRIVATE key YALNIZ server'da; client bundle'a sızmamalı (PROMPT 34 tarama).
# - SUBJECT mailto:… ya da https://… (web-push gereği).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:helios@example.invalid


# ============================ Postgres DB (PROMPT 30) ========================
# Neon serverless (Vercel Marketplace → Neon → Create). Schema migrasyonu:
# `pnpm dlx drizzle-kit push` (DATABASE_URL set'lendikten sonra, manuel).
DATABASE_URL=


