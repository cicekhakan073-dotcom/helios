# Helios — testnet deploy çıktısı için template.
# Gerçek değerler `scripts/deploy-testnet.sh` çalıştırıldığında `.env.testnet`
# dosyasına yazılır. Bu .example dosyası git'te kalır.
#
# .env.testnet ASLA commit edilmez (`.gitignore` zaten engelliyor).

STELLAR_NETWORK=testnet
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# --- Deployer (admin + keeper rolü) — script doldurur ---
DEPLOYER_ADDRESS=

# --- Helios contract ID'leri — script doldurur ---
HELIOS_STRATEGY_ROUTER=
HELIOS_KEEPER=

# --- Blend v2 testnet (STELLAR_STACK §5 + AUDIT §1; reset olabilir — # DOĞRULA) ---
BLEND_POOL=CCEBVDYM32YNYCVNRXQKDFFPISJJCV557CDZEIRBEE4NCV4KHPQ44HGF
BLEND_BACKSTOP=CBDVWXT433PRVTUNM56C3JREF3HIZHRBA64NB2C3B2UNCKIS65ZYCLZA
BLEND_POOL_FACTORY=CDV6RX4CGPCOKGTBFS52V3LMWQGZN3LCQTXF5RVPOOCG4XVMHXQ4NTF6
BLEND_EMITTER=CC3WJVJINN4E3LPMNTWKK7LQZLYDQMZHZA7EZGXATPHHBPKNZRIO3KZ6

# --- Reflector V3 testnet feeds (# DOĞRULA reset olabilir) ---
REFLECTOR_STELLAR_DEX=CAVLP5DH2GJPZMVO7IJY4CVOD5MWEFTJFVPD2YY2FQXOQHRGHK4D6HLP
REFLECTOR_EXT_CEX_DEX=CCYOZJCOPG34LLQQ7N24YXBM7LL62R7ONMZ3G6WZAAYPB5OYKOMJRN63
REFLECTOR_FIAT=CCSSOHTBL3LEWUCBBEB5NJFC2OKFRC74OWEIJIZLRJBGAAU4VMU5NV4W

# --- Config (init parametreleri — script bunları kullanır) ---
MAX_LEVERAGE_BPS=500    # 5x üst sınır
MIN_OPEN_HF_BPS=130     # 1.30 minimum HF (open post-check)
FLASH_FEE_BPS=0         # Blend flash fee (deploy anında pool config'inden okunmalı)
